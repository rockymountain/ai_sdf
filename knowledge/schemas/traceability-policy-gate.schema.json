{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate", "policy"],
  "properties": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "deterministic", "blocks_merge", "policy"],
      "properties": {
        "id": {"const": "QG-003"},
        "name": {"const": "traceability-policy"},
        "deterministic": {"const": true},
        "blocks_merge": {"const": true},
        "policy": {"const": "traceability"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "escalation_triggers", "t2_path_triggers"],
      "properties": {
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["T0", "T1", "T2"],
          "properties": {
            "T0": {"$ref": "#/$defs/level"},
            "T1": {"$ref": "#/$defs/level"},
            "T2": {"$ref": "#/$defs/level"}
          }
        },
        "escalation_triggers": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "architecture",
              "nfr",
              "security",
              "data_model",
              "external_contract",
              "reliability",
              "compliance",
              "migration"
            ]
          }
        },
        "t2_path_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "requires"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upstream_intent",
            "design",
            "decision_or_contract",
            "implementation",
            "verification",
            "risk_attestation"
          ],
          "properties": {
            "upstream_intent": {"type": "boolean"},
            "design": {"type": "boolean"},
            "decision_or_contract": {"type": "boolean"},
            "implementation": {"type": "boolean"},
            "verification": {"type": "boolean"},
            "risk_attestation": {"type": "boolean"}
          }
        }
      }
    }
  }
}
