{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "tasks": {
      "type": "object",
      "patternProperties": {
        "^DEV-[0-9]{3,}$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "implementation"
          ],
          "properties": {
            "level": {
              "enum": [
                "T0",
                "T1",
                "T2"
              ]
            },
            "intent": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(PROB|FR|NFR)-[0-9]{3,}$"
              }
            },
            "design": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^CMP-[0-9]{3,}$"
              }
            },
            "decisions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^ADR-[0-9]{3,}$"
              }
            },
            "contracts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(API|EVT)-[0-9]{3,}$"
              }
            },
            "verification": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^TEST-[0-9]{3,}$"
              }
            },
            "implementation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "paths"
              ],
              "properties": {
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
